@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetici Girişi - Admin Panel</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: #ffffff;
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
            width: 100%;
            max-width: 420px;
            padding: 3.5rem 3rem;
        }

        .login-header h2 {
            font-weight: 800;
            color: #1e293b;
            letter-spacing: -1px;
            margin-bottom: 0.5rem;
        }

        .login-header p {
            color: #94a3b8;
            font-size: 0.9rem;
            margin-bottom: 2.5rem;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #475569;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 16px;
            border: 2px solid #f1f5f9;
            background: #f8fafc;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .form-control:focus {
            background: #fff;
            border-color: #4361ee;
            box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
            outline: none;
        }

        .btn-login {
            background: #4361ee;
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            margin-top: 1.5rem;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(67, 97, 238, 0.2);
        }

        .btn-login:hover {
            background: #3651d1;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(67, 97, 238, 0.3);
        }

        .alert-custom {
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 500;
            border: none;
            background-color: #fee2e2;
            color: #b91c1c;
            padding: 12px;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }

        .brand-logo {
            width: 48px;
            height: 48px;
            background: #4361ee;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            color: white;
            font-size: 1.4rem;
        }
    </style>
</head>
<body>

    <div class="login-card shadow-lg">
        <div class="text-center login-header">
            <div class="brand-logo shadow-sm">
                <i class="bi bi-person-lock"></i>
            </div>
            <h2>Admin Girişi</h2>
            <p>Devam etmek için kimliğinizi doğrulayın.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-custom">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Admin" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" name="users" class="form-control" required autofocus />
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre</label>
                <input type="password" name="pass" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-login">
                Giriş Yap
            </button>
        </form>
    </div>

</body>
</html>